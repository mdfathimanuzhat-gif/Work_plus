# Copy this file to .env and replace placeholder values.
# Never commit .env.

POSTGRES_USER=workpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workpulse
POSTGRES_PORT=5432

# Used by the backend container (host is the Compose service name "db")
DATABASE_URL=postgresql+psycopg://workpulse:change-me@db:5432/workpulse

SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost

BACKEND_PORT=8000
FRONTEND_PORT=80
